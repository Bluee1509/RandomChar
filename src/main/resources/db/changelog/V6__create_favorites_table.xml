<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="6" author="fresher">
        <createTable tableName="favorites">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_favorite_user"
                             referencedTableName="users"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="actor_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_favorite_actor"
                             referencedTableName="actors"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <!-- Ràng buộc: Một user chỉ được yêu thích 1 diễn viên 1 lần -->
        <addUniqueConstraint tableName="favorites" columnNames="user_id, actor_id" constraintName="unique_user_actor_favorite"/>
    </changeSet>
</databaseChangeLog>